# Copy to .env.local. All values are optional.

# Leave VITE_API_URL unset: the dev server proxies /api and /ws to the backend,
# so the browser uses a single origin and the login cookie works.
# VITE_API_URL=https://api.example.com

# Where the dev server forwards API calls (default http://127.0.0.1:8000)
# VITE_PROXY_TARGET=http://127.0.0.1:8000

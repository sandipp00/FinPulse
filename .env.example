# Copy to .env and adjust. All values are optional.

# SQLite database location (default: data/finpulse.db)
# DATABASE_PATH=data/finpulse.db

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Live crypto feed (Binance public streams, no API key needed)
LIVE_FEED_ENABLED=true
LIVE_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,XRP/USDT,SOL/USDT,TRX/USDT,HYPE/USDT,ZEC/USDT,DOGE/USDT,LINK/USDT,ADA/USDT,XLM/USDT,NEAR/USDT,BCH/USDT,LTC/USDT,UNI/USDT,AVAX/USDT,SUI/USDT,GRAM/USDT,HBAR/USDT
# Tried in order; falls back to the next on failure or regional block
BINANCE_WS_URLS=wss://stream.binance.com:9443,wss://data-stream.binance.vision
# REST endpoints for historical candles (same fallback behaviour)
BINANCE_REST_URLS=https://api.binance.com,https://data-api.binance.vision
# Live gold, silver and oil: Binance USD-M perpetual futures (XAUUSDT, XAGUSDT, CLUSDT, BZUSDT), same terms, no key
TRADFI_LIVE_SYMBOLS=XAU/USDT,XAG/USDT,CL/USDT,BZ/USDT
BINANCE_FUTURES_WS_URLS=wss://fstream.binance.com/market
BINANCE_FUTURES_REST_URLS=https://fapi.binance.com
# Near-real-time stock, index and FX quotes, polled from Yahoo Finance every 15s (personal use)
# Default: the 30 US stocks, 36 world indices and 7 FX pairs listed in backend/config.py.
# YAHOO_LIVE_SYMBOLS=AAPL,NVDA,...
# Fresher Shanghai, Shenzhen and Hang Seng quotes from Tencent Finance (unofficial, personal use)
TENCENT_QUOTES_ENABLED=true
# Fama-French factors (Kenneth R. French Data Library, free) for US stocks' factor exposure.
FAMA_FRENCH_ENABLED=true
# Crypto derivatives from Deribit's public API (no key); each coin is fetched at most once a minute.
DERIBIT_ENABLED=true
# DERIBIT_API_URL=https://www.deribit.com/api/v2

# US macro data (FRED). Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Leave empty to run without macro data. Never commit the real key.
FRED_API_KEY=

# Crude oil spot prices (EIA). Get a free key at https://www.eia.gov/opendata/register.php
# Leave empty to run without oil prices. Never commit the real key.
EIA_API_KEY=

# SEC filings in the news feed. EDGAR requires a name and a contact email in the
# User-Agent, for example: SEC_USER_AGENT=FinPulse/1.0 you@example.com
# Leave empty to leave SEC filings out.
SEC_USER_AGENT=

# Paper trading (virtual money only)
PAPER_STARTING_CASH=100000
PAPER_FEE_PCT=0.1
PAPER_MAX_PRICE_AGE_SECONDS=15

# Accounts
ALLOW_REGISTRATION=true
SESSION_DAYS=30
# Set both to true when serving over HTTPS behind the bundled nginx / a proxy
COOKIE_SECURE=false
TRUST_PROXY=false

# ---- Email: verification links and password reset ---------------------------------
# Leave SMTP_HOST empty to run without email (no verification, no emailed reset).
# Any SMTP server works; free options include a Gmail app password (smtp.gmail.com,
# port 587), Brevo, Resend or Mailjet. See docs/DEPLOYMENT.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=FinPulse <no-reply@your-domain.example>
# The address people use to reach the site. Links in emails are built from this
# (never from the request), so set it correctly in production.
PUBLIC_URL=http://localhost:5173
# smtp (default when SMTP_HOST is set) | console (print emails to the server log) | off
# EMAIL_BACKEND=
# Defaults to true whenever email is configured.
# REQUIRE_EMAIL_VERIFICATION=
